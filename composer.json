{
    "name": "featvalue/contao",
    "description": "Embeds the FeatValue client portal in a Contao website.",
    "type": "contao-bundle",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.featvalue.com/contao",
    "keywords": ["contao", "contao-bundle", "client portal", "featvalue"],
    "authors": [
        {"name": "FeatValue", "email": "hello@featvalue.io", "homepage": "https://featvalue.io"}
    ],
    "support": {
        "email": "hello@featvalue.io",
        "source": "https://github.com/FeatValue/contao-bundle"
    },
    "require": {
        "php": "^8.1",
        "ext-sodium": "*",
        "ext-json": "*",
        "contao/core-bundle": "^5.3",
        "doctrine/dbal": "^3.6 || ^4.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/mailer": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0",
        "symfony/security-bundle": "^6.4 || ^7.0",
        "symfony/translation-contracts": "^2.5 || ^3.0",
        "twig/twig": "^3.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Featvalue\\ContaoBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Featvalue\\ContaoBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": true
        }
    }
}
